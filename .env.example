# Yume — local configuration. Copy to .env and set for your network:
#
#   cp .env.example .env
#
# .env is gitignored. Every value below is also settable as a plain
# environment variable, which takes precedence over this file.

# Suwayomi's API, as reached from your machine. The dev server proxies to it,
# and the tests and tools query it directly.
SUWAYOMI=http://suwayomi.local:4567

# Where Yume itself is served. The test suite points at this by default.
YUME_BASE=http://yume.local:8420

# Deployment target for scp/ssh, as user@host. Only used by hand.
DEPLOY_HOST=user@your-server
DEPLOY_PATH=~/docker/yume
